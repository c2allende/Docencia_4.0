<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Lección 1.3 de Docencia 4.0: Ética, seguridad y responsabilidad. Explora privacidad de datos, sesgos algorítmicos, dependencia tecnológica y el enfoque Human in the Loop.">
    <title>Lección 1.3 | Docencia 4.0 Prototipo</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="styles/main.css">
    <script type="module" src="scripts/auth-guard.js"></script>
    <script type="module" src="scripts/module-access-guard.js"></script>

    <style>
        :root {
            --nav-height: 80px;
            --module-sidebar-width: 320px;
        }

        /* Namespace: .leccion1-3-prototype */
        .leccion1-3-prototype {
            background: var(--color-background-page);
            padding: clamp(3rem, 5vw, 5rem) clamp(1rem, 3vw, 2rem);
            min-height: calc(100vh - var(--nav-height));
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
        }

        .leccion1-3-prototype .m1-floating-shell {
            width: min(100%, 1180px);
            margin: var(--spacing-12) auto var(--spacing-8);
            background: var(--color-background-surface);
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: var(--radius-2xl);
            box-shadow: 
                0 20px 25px -5px rgba(0, 0, 0, 0.05),
                0 10px 10px -5px rgba(0, 0, 0, 0.02);
            padding: clamp(2rem, 6vw, 5rem);
            overflow: visible;
            position: relative;
        }

        .leccion1-3-prototype .m1-floating-shell > :first-child {
            margin-top: 0;
        }

        .leccion1-3-prototype h1.lesson-title {
            font-size: clamp(2.2rem, 5.5vw, 3rem);
            line-height: 1.15;
            color: var(--color-text-display);
            margin: 0 0 var(--spacing-8);
            padding-top: 0;
            font-weight: 800;
            letter-spacing: var(--letter-spacing-tight);
        }

        .leccion1-3-prototype .section-title {
            font-size: var(--font-size-2xl);
            margin: var(--spacing-10) 0 var(--spacing-6);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-extrabold);
            line-height: 1.25;
        }

        .leccion1-3-prototype .section-title-sm {
            font-size: var(--font-size-lg);
            color: var(--color-brand-primary);
            margin: var(--spacing-8) 0 var(--spacing-4);
            font-weight: 800;
            letter-spacing: -0.01em;
            line-height: 1.3;
        }

        .leccion1-3-prototype .audio-player-container {
            background: var(--color-background-surface-low);
            padding: var(--spacing-lg);
            border-radius: var(--radius-lg);
            margin-bottom: var(--spacing-8);
            border: var(--border-width-1) solid var(--color-border-default);
        }

        .leccion1-3-prototype .audio-label {
            display: block;
            color: var(--color-brand-primary);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
            margin-bottom: var(--spacing-2);
        }

        .leccion1-3-prototype .audio-player {
            width: 100%;
        }

        .leccion1-3-prototype .organizer-card {
            background: var(--color-background-surface-low);
            border-left: var(--border-width-4) solid var(--color-brand-secondary);
            padding: var(--spacing-8);
            border-radius: var(--radius-xl);
            margin-bottom: var(--spacing-10);
            box-shadow: var(--shadow-sm);
        }

        .leccion1-3-prototype .organizer-card p {
            margin: 0;
            color: var(--color-text-secondary);
            font-size: var(--font-size-base);
            line-height: 1.6;
        }

        .leccion1-3-prototype p {
            line-height: 1.7;
            margin-bottom: var(--spacing-6);
            color: var(--color-text-primary);
        }

        .leccion1-3-prototype .content-list,
        .leccion1-3-prototype .icon-list {
            margin: var(--spacing-md) 0;
            padding-left: var(--spacing-6);
        }

        .leccion1-3-prototype .content-list li,
        .leccion1-3-prototype .icon-list li {
            margin-bottom: var(--spacing-3);
            line-height: 1.6;
            color: var(--color-text-secondary);
        }

        .leccion1-3-prototype .content-list li::marker {
            color: var(--color-brand-primary);
            font-weight: var(--font-weight-extrabold);
        }

        .leccion1-3-prototype .icon-list {
            list-style: none;
            padding-left: 0;
        }

        /* Floating shell — separada del banner */
        .leccion1-3-prototype .m1-floating-shell {
            margin-top: clamp(2.5rem, 5vw, 4.5rem);
        }

        /* Section spacing — compacto */
        .leccion1-3-prototype .lesson-section {
            margin-block: clamp(2rem, 4vw, 3.25rem);
        }

        /* Split editorial layout (texto + imagen) */
        .leccion1-3-prototype .split-section {
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
            gap: clamp(1.5rem, 3vw, 2.5rem);
            align-items: start;
        }

        .leccion1-3-prototype .split-section.image-left {
            grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.15fr);
        }

        .leccion1-3-prototype .section-copy {
            min-width: 0;
        }

        /* Media Cards — compactas, acompañan al texto */
        .leccion1-3-prototype .lesson-media-card {
            width: 100%;
            max-width: 460px;
            margin: 0 auto;
            padding: 0.75rem;
            border: 1px solid var(--color-border-subtle, #e5e7eb);
            border-radius: 1.25rem;
            background: #ffffff;
            box-shadow: 0 14px 30px rgba(15, 23, 42, 0.06);
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .leccion1-3-prototype .lesson-media-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.1);
        }

        .leccion1-3-prototype .lesson-media-card img {
            display: block;
            width: 100%;
            height: auto;
            max-height: 300px;
            object-fit: contain;
            border-radius: 0.9rem;
        }

        .leccion1-3-prototype .lesson-media-card figcaption {
            margin-top: 0.5rem;
            font-size: 0.76rem;
            color: var(--color-text-muted, #64748b);
            font-style: italic;
        }

        /* Image Zoom */
        .leccion1-3-prototype .image-zoom-trigger {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            cursor: zoom-in;
            width: 100%;
            transition: transform 0.3s ease;
            position: relative;
            display: block;
        }

        .leccion1-3-prototype .image-zoom-trigger:hover {
            transform: scale(1.02);
        }

        .leccion1-3-prototype .image-zoom-trigger::after {
            content: "🔍 Ampliar";
            position: absolute;
            bottom: var(--spacing-4);
            right: var(--spacing-4);
            background: rgba(15, 23, 42, 0.8);
            color: white;
            padding: 4px 10px;
            border-radius: var(--radius-pill);
            font-size: 0.7rem;
            font-weight: 700;
            opacity: 0;
            transition: opacity 0.3s ease;
            backdrop-filter: blur(4px);
        }

        .leccion1-3-prototype .image-zoom-trigger:hover::after {
            opacity: 1;
        }

        /* Highlight Box */
        .leccion1-3-prototype .highlight-box {
            clear: both;
            padding: var(--spacing-lg);
            margin: var(--spacing-xl) 0;
            background: var(--color-background-surface-low);
            border-left: var(--border-width-6) solid var(--color-brand-primary);
            border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
            color: var(--color-text-secondary);
        }

        .leccion1-3-prototype .highlight-box p {
            color: var(--color-text-secondary);
        }

        /* Recommendations Box */
        .leccion1-3-prototype .recommendations-box {
            padding: var(--spacing-xl);
            margin: var(--spacing-xl) 0;
            background: var(--color-background-surface-low);
            border: var(--border-width-1) dashed var(--color-brand-primary);
            border-radius: var(--radius-xl);
        }

        .leccion1-3-prototype .recommendations-title {
            display: flex;
            align-items: center;
            gap: var(--spacing-2);
            margin-bottom: var(--spacing-md);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-extrabold);
            font-size: var(--font-size-xl);
        }

        /* Comparison Grid */
        .leccion1-3-prototype .comparison-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: var(--spacing-md);
            margin: var(--spacing-xl) 0;
        }

        .leccion1-3-prototype .comp-card {
            padding: var(--spacing-xl);
            background: var(--color-background-surface);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
            transition: none;
            transform: none;
        }

        .leccion1-3-prototype .comp-card:hover {
            border-color: var(--color-brand-primary);
            box-shadow: var(--shadow-ambient);
            transform: none;
        }

        .leccion1-3-prototype .comp-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: var(--spacing-md);
            border-radius: var(--radius-lg);
            background: var(--color-background-surface-low);
            color: var(--color-brand-primary);
            font-size: var(--font-size-2xl);
        }

        .leccion1-3-prototype .comp-card h3 {
            margin: 0 0 var(--spacing-sm);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-bold);
            line-height: var(--line-height-snug);
        }

        .leccion1-3-prototype .comp-card p {
            color: var(--color-text-secondary);
            margin: 0;
        }

        /* Role Cards Grid (Nueva sección) */
        .leccion1-3-prototype .role-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: var(--spacing-8);
            margin: var(--spacing-8) 0;
            align-items: start;
        }

        .leccion1-3-prototype .role-card {
            padding: clamp(1.25rem, 2vw, 1.75rem);
            background: var(--color-background-surface-low);
            border: 1px solid var(--color-border-soft, rgba(15, 23, 42, 0.08));
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-soft);
            transition: none;
            transform: none;
            height: 100%;
        }

        .leccion1-3-prototype .role-card:hover {
            border-color: var(--color-border-soft, rgba(15, 23, 42, 0.08));
            box-shadow: var(--shadow-soft);
            transform: none;
        }

        .leccion1-3-prototype .role-card h3 {
            margin-top: 0;
            color: var(--color-brand-primary);
            font-size: var(--font-size-lg);
            font-weight: 800;
            margin-bottom: var(--spacing-4);
        }

        .leccion1-3-prototype .role-card p {
            color: var(--color-text-secondary);
            margin: 0;
            line-height: 1.6;
        }

        /* Section Spacing */
        .leccion1-3-prototype .lesson-section {
            margin-block: clamp(2.5rem, 4vw, 4rem);
        }

        .leccion1-3-prototype .lesson-section + .lesson-section {
            margin-top: clamp(2.75rem, 4.5vw, 4.5rem);
        }

        .leccion1-3-prototype .section-separator {
            border: 0;
            border-top: var(--border-width-1) solid var(--color-border-default);
            margin: var(--spacing-12) 0;
        }

        /* Completion Card */
        .leccion1-3-prototype .completion-card {
            margin: var(--spacing-10) 0;
            padding: var(--spacing-10);
            border-radius: var(--radius-xl);
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            box-shadow: var(--shadow-ambient);
            position: relative;
        }

        .leccion1-3-prototype .completion-badge {
            position: absolute;
            top: calc(-1 * var(--spacing-5));
            right: var(--spacing-xl);
            padding: var(--spacing-2) var(--spacing-5);
            border-radius: var(--radius-pill);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
        }

        /* Checkpoint */
        .leccion1-3-prototype .genially-checkpoint {
            margin: var(--spacing-10) 0;
        }

        .leccion1-3-prototype .genially-checkpoint__content {
            padding: var(--spacing-xl);
            border-radius: var(--radius-xl);
            background: var(--gradient-orange);
            color: var(--color-white);
            box-shadow: var(--shadow-focus-secondary);
        }

        .leccion1-3-prototype .genially-checkpoint__content h2,
        .leccion1-3-prototype .genially-checkpoint__content p {
            color: var(--color-white);
        }

        .leccion1-3-prototype .genially-checkpoint__eyebrow {
            display: block;
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
            opacity: 0.9;
            margin-bottom: var(--spacing-2);
        }

        .leccion1-3-prototype .genially-checkpoint__title {
            font-family: var(--font-family-heading);
            font-size: var(--font-size-2xl);
            font-weight: var(--font-weight-extrabold);
            margin: 0 0 var(--spacing-4);
        }

        .leccion1-3-prototype .genially-checkpoint__description {
            margin-bottom: var(--spacing-lg);
            opacity: 0.95;
        }

        .leccion1-3-prototype .genially-checkpoint__actions {
            display: flex;
            flex-wrap: wrap;
            gap: var(--spacing-4);
            align-items: center;
        }

        .leccion1-3-prototype .genially-checkpoint__toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--spacing-2);
            padding: var(--spacing-4) var(--spacing-xl);
            border-radius: var(--radius-pill);
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-bold);
            text-decoration: none;
            background: var(--color-white);
            color: var(--color-brand-primary);
            border: none;
            cursor: pointer;
            transition: transform var(--motion-duration-default) var(--motion-easing-standard),
                box-shadow var(--motion-duration-default) var(--motion-easing-standard);
        }

        .leccion1-3-prototype .genially-checkpoint__toggle:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-floating);
        }

        .leccion1-3-prototype .genially-checkpoint__fallback {
            color: var(--color-white);
            text-decoration: underline;
            font-weight: var(--font-weight-semibold);
        }

        .leccion1-3-prototype .genially-checkpoint__note {
            font-size: var(--font-size-sm);
            margin-top: var(--spacing-4);
            opacity: 0.85;
        }

        .leccion1-3-prototype .genially-checkpoint__frame-wrap {
            width: 100%;
            max-width: 960px;
            margin: var(--spacing-lg) auto 0;
            overflow: hidden;
            border-radius: var(--radius-lg);
            background: var(--color-background-surface);
            box-shadow: var(--shadow-ambient);
            aspect-ratio: 16 / 9;
            max-height: 540px;
        }

        .leccion1-3-prototype .genially-checkpoint__frame-wrap iframe {
            width: 100%;
            height: 100%;
            border: 0;
        }

        /* References */
        .leccion1-3-prototype .references-compact {
            margin: var(--spacing-10) 0;
        }

        .leccion1-3-prototype .references-compact__summary {
            display: flex;
            align-items: center;
            gap: var(--spacing-4);
            padding: var(--spacing-lg);
            background: var(--color-background-surface-low);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-lg);
            cursor: pointer;
            list-style: none;
        }

        .leccion1-3-prototype .references-compact__summary::-webkit-details-marker {
            display: none;
        }

        .leccion1-3-prototype .references-compact__title {
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-extrabold);
            color: var(--color-text-display);
        }

        .leccion1-3-prototype .references-compact__count {
            font-size: var(--font-size-sm);
            color: var(--color-text-secondary);
        }

        .leccion1-3-prototype .references-compact__action {
            margin-left: auto;
            font-size: var(--font-size-sm);
            color: var(--color-brand-primary);
            font-weight: var(--font-weight-semibold);
        }

        .leccion1-3-prototype .references-compact__body {
            padding: var(--spacing-lg);
        }

        .leccion1-3-prototype .reference-list {
            margin: 0;
            padding-left: var(--spacing-6);
        }

        .leccion1-3-prototype .reference-list li {
            margin-bottom: var(--spacing-3);
            color: var(--color-text-secondary);
            font-size: var(--font-size-sm);
            line-height: var(--line-height-relaxed);
        }

        /* Footer Nav */
        .leccion1-3-prototype .m1-footer-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: var(--spacing-12);
            padding-top: var(--spacing-8);
            border-top: var(--border-width-1) solid var(--color-border-subtle);
            gap: var(--spacing-8);
        }

        .leccion1-3-prototype .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 28px;
            border-radius: var(--radius-lg);
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            font-size: 0.95rem;
        }

        .leccion1-3-prototype .btn-primary {
            background: var(--color-brand-primary);
            color: white;
            border: none;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.15);
        }

        .leccion1-3-prototype .btn-primary:hover {
            background: #1e293b;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.2);
        }

        .leccion1-3-prototype .btn-secondary {
            background: var(--color-background-surface);
            color: var(--color-brand-primary);
            border: 1px solid var(--color-border-default);
        }

        .leccion1-3-prototype .btn-secondary:hover {
            background: var(--color-slate-50);
            border-color: var(--color-brand-primary);
            transform: translateY(-2px);
        }

        /* Modal Zoom */
        .modal-zoom {
            display: none;
            position: fixed;
            z-index: 10000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(8px);
            opacity: 0;
            transition: opacity 0.3s ease;
            align-items: center;
            justify-content: center;
        }

        .modal-zoom.is-open {
            display: flex;
            opacity: 1;
        }

        .modal-zoom .modal-content {
            position: relative;
            max-width: 90%;
            max-height: 90%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-zoom img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: var(--radius-lg);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .modal-close-btn {
            position: absolute;
            top: -50px;
            right: 0;
            color: white;
            font-size: 35px;
            font-weight: bold;
            cursor: pointer;
            background: none;
            border: none;
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            transition: background 0.2s;
        }

        .modal-close-btn:hover { background: rgba(255, 255, 255, 0.2); }

        /* Top Nav */
        .top-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            height: var(--nav-height);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 var(--spacing-md);
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--color-border-default);
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }

        .logo-container img {
            height: 52px;
            width: auto;
        }

        .module-title-nav {
            font-family: var(--font-family-heading);
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--color-text-display);
            margin-left: var(--spacing-4);
            border-left: 2px solid var(--color-border-default);
            padding-left: var(--spacing-4);
        }

        .menu-btn {
            background: none;
            border: none;
            color: var(--color-text-primary);
            cursor: pointer;
            padding: var(--spacing-2);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-sm);
            transition: background 0.2s;
        }

        .menu-btn:hover { background: var(--color-slate-100); }

        /* Responsive */
        @media (max-width: 900px) {
            .module-title-nav { display: none; }
        }

        @media (max-width: 768px) {
            .leccion1-3-prototype {
                padding-top: calc(var(--nav-height) + var(--spacing-8));
                padding-inline: var(--spacing-4);
            }

            .leccion1-3-prototype .m1-floating-shell {
                margin-top: 2rem;
                padding-top: clamp(2rem, 8vw, 3rem);
                padding-inline: var(--spacing-6);
                padding-bottom: clamp(2rem, 8vw, 3rem);
                border-radius: var(--radius-xl);
                box-shadow: var(--shadow-md);
            }

            .leccion1-3-prototype h1.lesson-title {

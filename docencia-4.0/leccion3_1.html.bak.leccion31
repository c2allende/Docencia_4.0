<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Lección 3.1 de Docencia 4.0: Diseño automatizado de instrumentos de evaluación con LLM, rúbricas, listas de cotejo, bancos de reactivos e integración LMS.">
    <meta name="keywords"
        content="Docencia 4.0, Lección 3.1, evaluación educativa, rúbricas, listas de cotejo, bancos de reactivos, LMS, LLM, IA educativa, Bloom, Webb DOK">
    <title>Lección 3.1 | Docencia 4.0</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="styles/main.css">
    <script type="module" src="scripts/auth-guard.js"></script>
    <script type="module" src="scripts/module-access-guard.js"></script>

    <style>
        :root {
            --nav-height: 80px;
            --module-sidebar-width: 320px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding-top: var(--nav-height);
            overflow-x: hidden;
            background: var(--color-background-page);
            color: var(--color-text-primary);
            font-family: var(--font-family-body);
            line-height: var(--line-height-loose);
        }

        p {
            margin: 0 0 var(--spacing-sm);
            color: var(--color-text-secondary);
        }

        strong {
            color: var(--color-text-primary);
            font-weight: var(--font-weight-bold);
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        /* NAVBAR SUPERIOR */
        .top-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            height: var(--nav-height);
            min-height: var(--nav-height);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 var(--spacing-md);
            background: var(--color-alpha-white-90);
            backdrop-filter: blur(var(--blur-lg));
            -webkit-backdrop-filter: blur(var(--blur-lg));
            border-bottom: var(--border-width-1) solid var(--color-border-default);
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            min-width: 0;
        }

        .logo-container img {
            height: 56px;
            width: auto;
            display: block;
            object-fit: contain;
            flex-shrink: 0;
        }

        .module-title-nav {
            max-width: 65vw;
            overflow: hidden;
            padding-left: var(--spacing-sm);
            margin-left: var(--spacing-xs);
            border-left: var(--border-width-2) solid var(--color-border-default);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-base);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .menu-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--spacing-2);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-md);
            background: var(--color-background-surface-medium);
            color: var(--color-brand-primary);
            cursor: pointer;
            transition: background-color var(--motion-duration-default) var(--motion-easing-standard),
                color var(--motion-duration-default) var(--motion-easing-standard),
                transform var(--motion-duration-default) var(--motion-easing-standard);
        }

        .menu-btn:hover {
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            transform: translateY(-1px);
        }

        .menu-btn:focus-visible,
        .menu-links a:focus-visible,
        .btn-footer:focus-visible,
        .control-btn:focus-visible,
        .eval-nav-btn:focus-visible,
        .bloom-item:focus-visible,
        .image-zoom-trigger:focus-visible,
        .modal-close-btn:focus-visible,
        .btn-scroll-top:focus-visible,
        .genially-frame-inner iframe:focus-visible {
            outline: var(--border-width-2) solid var(--color-border-focus);
            outline-offset: var(--spacing-1);
        }

        /* MENÚ LATERAL */
        .module-sidebar {
            position: fixed;
            top: 0;
            left: calc(-1 * var(--module-sidebar-width) - 20px);
            z-index: 2000;
            width: var(--module-sidebar-width);
            height: 100vh;
            padding: var(--spacing-lg) var(--spacing-md);
            overflow-y: auto;
            background: var(--color-background-surface-dark);
            color: var(--color-text-inverse);
            transition: left var(--motion-duration-emphasis) var(--motion-easing-standard),
                box-shadow var(--motion-duration-default) var(--motion-easing-standard);
        }

        .module-sidebar.active {
            left: 0;
            box-shadow: 20px 0 50px var(--color-alpha-black-15);
        }

        .module-sidebar-overlay {
            position: fixed;
            inset: 0;
            z-index: 1999;
            display: none;
            background: var(--color-alpha-black-40, rgba(0, 0, 0, 0.4));
            backdrop-filter: blur(var(--blur-sm));
            -webkit-backdrop-filter: blur(var(--blur-sm));
        }

        .module-sidebar-overlay.active {
            display: block;
        }

        .side-menu-title {
            margin: 0 0 var(--spacing-md);
            color: var(--color-text-inverse);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
        }

        .menu-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .menu-links li {
            margin-bottom: var(--spacing-xs);
        }

        .menu-section-label {
            display: block;
            padding: var(--spacing-5) var(--spacing-4) var(--spacing-2);
            color: var(--color-cyan-100);
            font-family: var(--font-family-body);
            font-size: var(--font-size-2xs);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
            letter-spacing: var(--letter-spacing-wider);
            text-transform: uppercase;
            opacity: 0.9;
        }

        .menu-links a {
            display: flex;
            align-items: center;
            gap: var(--spacing-3);
            padding: var(--spacing-3) var(--spacing-4);
            border-radius: var(--radius-md);
            color: var(--color-alpha-white-70);
            font-family: var(--font-family-body);
            font-size: var(--font-size-base);
            font-weight: var(--font-weight-semibold);
            line-height: var(--line-height-normal);
            text-decoration: none;
            transition: background-color var(--motion-duration-default) var(--motion-easing-standard),
                color var(--motion-duration-default) var(--motion-easing-standard);
        }

        .menu-links a:hover {
            background: var(--color-alpha-white-15);
            color: var(--color-cyan-100);
        }

        .menu-links a.active {
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            font-weight: var(--font-weight-bold);
        }

        /* CONTENIDO PRINCIPAL */
        .content-wrapper {
            max-width: 1100px;
            margin: var(--spacing-xl) auto var(--spacing-16);
            padding: 0 var(--spacing-md);
        }

        .lesson-card {
            position: relative;
            overflow: hidden;
            padding: var(--spacing-16);
            margin-bottom: var(--spacing-lg);
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-ambient);
        }

        .lesson-title {
            margin: 0 0 var(--spacing-lg);
            color: var(--color-text-display);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-4xl);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
            letter-spacing: var(--letter-spacing-tight);
        }

        .section-title {
            margin: 0 0 var(--spacing-md);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-2xl);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-snug);
        }

        .subsection-title {
            margin: var(--spacing-md) 0 var(--spacing-sm);
            color: var(--color-brand-secondary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-extrabold);
        }

        .text-section {
            clear: both;
            margin-bottom: var(--spacing-12);
        }

        .audio-player-container {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-2);
            padding: var(--spacing-lg);
            margin-bottom: var(--spacing-10);
            background: var(--color-background-surface-low);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-lg);
        }

        .audio-label {
            display: block;
            color: var(--color-brand-primary);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
        }

        .audio-player {
            width: 100%;
        }

        .content-list,
        .content-list-ordered {
            margin: var(--spacing-md) 0 var(--spacing-xl);
            padding-left: var(--spacing-6);
        }

        .content-list li,
        .content-list-ordered li {
            margin-bottom: var(--spacing-3);
            color: var(--color-text-secondary);
            line-height: var(--line-height-relaxed);
        }

        .content-list li::marker,
        .content-list-ordered li::marker {
            color: var(--color-brand-primary);
            font-weight: var(--font-weight-extrabold);
        }

        .highlight-box {
            padding: var(--spacing-xl);
            margin: var(--spacing-xl) 0;
            background: var(--color-background-surface-low);
            border-left: var(--border-width-6) solid var(--color-brand-primary);
            border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
            box-shadow: var(--shadow-flat);
        }

        .warning-box {
            border-left-color: var(--color-brand-secondary);
        }

        .prompt-example {
            padding: var(--spacing-lg);
            margin: var(--spacing-lg) 0;
            border-radius: var(--radius-lg);
            background: var(--color-background-card-inverse);
            color: var(--color-cyan-100);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
            font-size: var(--font-size-sm);
            line-height: var(--line-height-loose);
        }

        .prompt-example p,
        .prompt-example li {
            color: var(--color-alpha-white-90);
        }

        .comparison-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: var(--spacing-lg);
            margin: var(--spacing-xl) 0;
        }

        .comp-card {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-sm);
            padding: var(--spacing-xl);
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
            transition: transform var(--motion-duration-default) var(--motion-easing-standard),
                border-color var(--motion-duration-default) var(--motion-easing-standard),
                box-shadow var(--motion-duration-default) var(--motion-easing-standard);
        }

        .comp-card:hover {
            transform: translateY(-5px);
            border-color: var(--color-brand-primary);
            box-shadow: var(--shadow-ambient);
        }

        .comp-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-lg);
            background: var(--color-background-surface-low);
            color: var(--color-brand-primary);
            font-size: var(--font-size-2xl);
        }

        .comp-card h3 {
            margin: 0;
            color: var(--color-text-display);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-snug);
        }

        .img-container-premium {
            margin: var(--spacing-16) 0;
            text-align: center;
        }

        .image-zoom-trigger {
            display: inline-block;
            max-width: min(100%, 900px);
            padding: 0;
            overflow: hidden;
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            background: var(--color-background-surface-low);
            box-shadow: var(--shadow-ambient);
            cursor: zoom-in;
        }

        .image-zoom-trigger img {
            width: 100%;
            display: block;
            transition: transform var(--motion-duration-default) var(--motion-easing-standard);
        }

        .image-zoom-trigger:hover img {
            transform: scale(1.01);
        }

        .img-caption {
            margin-top: var(--spacing-md);
            color: var(--color-text-muted);
            font-size: var(--font-size-sm);
            font-weight: var(--font-weight-semibold);
            line-height: var(--line-height-relaxed);
        }

        /* COMPONENTE INTERACTIVO */
        .interactive-eval-component {
            padding: var(--spacing-xl);
            margin: var(--spacing-16) 0;
            background: var(--color-background-surface-low);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
        }

        .eval-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .eval-header {
            padding: var(--spacing-xl);
            margin-bottom: var(--spacing-xl);
            border-radius: var(--radius-xl);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            text-align: center;
            box-shadow: var(--shadow-focus-primary);
        }

        .eval-header h2 {
            margin: 0 0 var(--spacing-sm);
            color: var(--color-brand-primary-on);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-2xl);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
        }

        .eval-header p {
            margin: 0;
            color: var(--color-brand-primary-on);
            opacity: 0.92;
        }

        .eval-badge {
            display: inline-block;
            padding: var(--spacing-1) var(--spacing-3);
            margin-bottom: var(--spacing-sm);
            border-radius: var(--radius-pill);
            background: var(--color-alpha-white-20, var(--color-alpha-white-15));
            color: var(--color-brand-primary-on);
            font-size: var(--font-size-2xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
        }

        .eval-tabs {
            display: flex;
            justify-content: center;
            gap: var(--spacing-sm);
            margin-bottom: var(--spacing-lg);
            overflow-x: auto;
            padding: var(--spacing-2);
        }

        .eval-nav-btn {
            padding: var(--spacing-3) var(--spacing-5);
            border: var(--border-width-2) solid var(--color-border-default);
            border-radius: var(--radius-pill);
            background: var(--color-background-surface);
            color: var(--color-text-muted);
            font-family: var(--font-family-body);
            font-weight: var(--font-weight-bold);
            cursor: pointer;
            white-space: nowrap;
            transition: transform var(--motion-duration-default) var(--motion-easing-standard),
                background-color var(--motion-duration-default) var(--motion-easing-standard),
                border-color var(--motion-duration-default) var(--motion-easing-standard),
                color var(--motion-duration-default) var(--motion-easing-standard);
        }

        .eval-nav-btn:hover,
        .eval-nav-btn.active {
            transform: translateY(-2px);
            background: var(--color-brand-primary);
            border-color: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
        }

        .eval-panel {
            display: none;
            padding: var(--spacing-xl);
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
        }

        .eval-panel.active {
            display: block;
            animation: fadeInEval var(--motion-duration-default) var(--motion-easing-standard);
        }

        @keyframes fadeInEval {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .eval-panel h3 {
            margin: 0 0 var(--spacing-md);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-extrabold);
        }

        .interactive-box {
            padding: var(--spacing-lg);
            margin-top: var(--spacing-lg);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-lg);
            background: var(--color-background-surface-low);
        }

        .table-container {
            overflow-x: auto;
            margin: var(--spacing-lg) 0;
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-lg);
            background: var(--color-background-surface);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: var(--font-size-sm);
        }

        th,
        td {
            padding: var(--spacing-3);
            border: var(--border-width-1) solid var(--color-border-default);
            text-align: left;
            vertical-align: top;
        }

        th {
            background: var(--color-background-surface-low);
            color: var(--color-brand-primary);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
        }

        .bloom-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: var(--spacing-md);
            margin: var(--spacing-lg) 0;
        }

        .bloom-item {
            min-height: 86px;
            padding: var(--spacing-lg);
            border: var(--border-width-2) solid var(--color-border-default);
            border-radius: var(--radius-lg);
            background: var(--color-background-surface);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-extrabold);
            text-align: center;
            cursor: pointer;
            transition: transform var(--motion-duration-default) var(--motion-easing-standard),
                background-color var(--motion-duration-default) var(--motion-easing-standard),
                color var(--motion-duration-default) var(--motion-easing-standard),
                border-color var(--motion-duration-default) var(--motion-easing-standard);
        }

        .bloom-item:hover {
            transform: translateY(-4px);
            background: var(--color-brand-primary);
            border-color: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
        }

        .alert-box {
            display: flex;
            gap: var(--spacing-md);
            align-items: flex-start;
            padding: var(--spacing-lg);
            margin-top: var(--spacing-xl);
            border: var(--border-width-1) solid var(--color-border-default);
            border-left: var(--border-width-6) solid var(--color-brand-secondary);
            border-radius: var(--radius-xl);
            background: var(--color-background-surface-low);
        }

        .workflow {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
            margin-top: var(--spacing-lg);
        }

        .workflow-step {
            display: flex;
            gap: var(--spacing-md);
            align-items: flex-start;
            padding: var(--spacing-lg);
            background: var(--color-background-surface-low);
            border: var(--border-width-1) solid var(--color-border-default);
            border-left: var(--border-width-6) solid var(--color-brand-primary);
            border-radius: var(--radius-lg);
            transition: transform var(--motion-duration-default) var(--motion-easing-standard);
        }

        .workflow-step:hover {
            transform: translateX(8px);
        }

        .step-num {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 36px;
            border-radius: var(--radius-pill);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            font-weight: var(--font-weight-extrabold);
        }

        /* SLIDER */
        .slider-section {
            margin: var(--spacing-16) 0;
            padding: var(--spacing-xl);
            background: var(--color-background-surface-low);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
        }

        .slider-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: var(--spacing-md);
            margin-bottom: var(--spacing-xl);
        }

        .slider-header h2 {
            margin: 0;
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-2xl);
            font-weight: var(--font-weight-extrabold);
        }

        .slider-controls {
            display: flex;
            gap: var(--spacing-sm);
        }

        .control-btn {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: var(--border-width-2) solid var(--color-border-default);
            border-radius: var(--radius-pill);
            background: var(--color-background-surface);
            color: var(--color-brand-primary);
            font-size: var(--font-size-lg);
            cursor: pointer;
            transition: background-color var(--motion-duration-default) var(--motion-easing-standard),
                color var(--motion-duration-default) var(--motion-easing-standard),
                border-color var(--motion-duration-default) var(--motion-easing-standard),
                transform var(--motion-duration-default) var(--motion-easing-standard),
                opacity var(--motion-duration-default) var(--motion-easing-standard);
        }

        .control-btn:hover:not(:disabled) {
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            border-color: var(--color-brand-primary);
            transform: scale(1.05);
        }

        .control-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .slider-container {
            overflow: hidden;
            position: relative;
            padding: var(--spacing-2);
        }

        .slider-track {
            display: flex;
            gap: var(--spacing-lg);
            transition: transform var(--motion-duration-emphasis) var(--motion-easing-standard);
        }

        .slider-item {
            min-width: 100%;
            padding: var(--spacing-xl);
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
        }

        .slider-item h3 {
            margin: 0 0 var(--spacing-sm);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-xl);
        }

        .concept-ref {
            display: block;
            margin-top: var(--spacing-md);
            color: var(--color-text-muted);
            font-size: var(--font-size-xs);
            line-height: var(--line-height-relaxed);
            font-style: italic;
        }

        .completion-card {
            position: relative;
            margin-top: var(--spacing-16);
            padding: var(--spacing-xl);
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
        }

        .completion-badge {
            position: absolute;
            top: calc(-1 * var(--spacing-5));
            right: var(--spacing-xl);
            padding: var(--spacing-2) var(--spacing-5);
            border-radius: var(--radius-pill);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
        }

        .checkpoint-container {
            margin-top: var(--spacing-16);
            padding: var(--spacing-xl);
            border-radius: var(--radius-xl);
            background: var(--gradient-orange);
            color: var(--color-white);
            box-shadow: var(--shadow-focus-secondary);
        }

        .checkpoint-container h2,
        .checkpoint-container p {
            color: var(--color-white);
        }

        .genially-frame-wrap {
            width: 100%;
            margin-top: var(--spacing-lg);
            overflow: hidden;
            border-radius: var(--radius-lg);
            background: var(--color-background-surface);
            box-shadow: var(--shadow-ambient);
        }

        .genially-frame-inner {
            position: relative;
            width: 100%;
            height: 0;
            padding-bottom: 56.25%;
        }

        .genially-frame-inner iframe {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

        .references-section {
            margin-top: var(--spacing-16);
            padding: var(--spacing-xl);
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
        }

        .references-section h2 {
            margin-top: 0;
        }

        .ref-list {
            margin: 0;
            padding-left: var(--spacing-6);
        }

        .ref-list li {
            margin-bottom: var(--spacing-3);
            color: var(--color-text-secondary);
            font-size: var(--font-size-sm);
            line-height: var(--line-height-relaxed);
        }

        .footer-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: var(--spacing-md);
            margin-top: var(--spacing-16);
            padding-top: var(--spacing-xl);
            border-top: var(--border-width-1) solid var(--color-border-default);
        }

        .btn-footer {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--spacing-2);
            padding: var(--spacing-4) var(--spacing-xl);
            border-radius: var(--radius-pill);
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-bold);
            text-decoration: none;
            transition: transform var(--motion-duration-default) var(--motion-easing-standard),
                box-shadow var(--motion-duration-default) var(--motion-easing-standard),
                background-color var(--motion-duration-default) var(--motion-easing-standard);
        }

        .btn-back {
            background: var(--color-background-surface-low);
            color: var(--color-text-primary);
        }

        .btn-back:hover {
            transform: translateX(-5px);
        }

        .btn-next {
            background: var(--color-background-button-primary-default, var(--color-brand-secondary));
            color: var(--color-text-button-primary-default, var(--color-white));
            box-shadow: var(--shadow-focus-secondary);
        }

        .btn-next:hover {
            transform: translateX(5px);
            box-shadow: var(--shadow-floating);
        }

        .btn-scroll-top {
            position: fixed;
            right: var(--spacing-lg);
            bottom: var(--spacing-lg);
            z-index: 100;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-pill);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            text-decoration: none;
            box-shadow: var(--shadow-floating);
            opacity: 0;
            visibility: hidden;
            transition: opacity var(--motion-duration-default) var(--motion-easing-standard),
                visibility var(--motion-duration-default) var(--motion-easing-standard),
                transform var(--motion-duration-default) var(--motion-easing-standard);
        }

        .btn-scroll-top.visible {
            opacity: 1;
            visibility: visible;
        }

        .btn-scroll-top:hover {
            transform: translateY(-3px);
        }

        /* MODAL */
        .modal-zoom {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: var(--spacing-6);
            background: var(--color-alpha-black-90, var(--color-background-card-inverse));
        }

        .modal-zoom.is-open {
            display: flex;
        }

        .modal-content {
            position: relative;
            max-width: min(1100px, 95vw);
            max-height: 90vh;
        }

        .modal-content img {
            max-width: 100%;
            max-height: 90vh;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-overlay);
        }

        .modal-close-btn {
            position: absolute;
            top: var(--spacing-3);
            right: var(--spacing-3);
            width: 44px;
            height: 44px;
            border: none;
            border-radius: var(--radius-pill);
            background: var(--color-alpha-white-90);
            color: var(--color-text-primary);
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-bold);
            cursor: pointer;
            box-shadow: var(--shadow-sm);
        }

        /* TOOLBOX & PROMPT CARDS (Local) */
        .toolbox-card {
            position: relative;
            overflow: hidden;
            padding: var(--spacing-xl);
            margin: var(--spacing-16) 0;
            background: var(--color-background-card-inverse);
            border-radius: var(--radius-xl);
            color: var(--color-text-inverse);
            box-shadow: var(--shadow-ambient);
        }

        .toolbox-card::before {
            content: "TOOLBOX";
            position: absolute;
            top: -24px;
            right: -18px;
            color: var(--color-alpha-white-15);
            font-family: var(--font-family-heading);
            font-size: clamp(4rem, 12vw, 8rem);
            font-weight: var(--font-weight-extrabold);
            line-height: 1;
            pointer-events: none;
        }

        .toolbox-title {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            margin-bottom: var(--spacing-lg);
            color: var(--color-cyan-100);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-2xl);
            font-weight: var(--font-weight-extrabold);
        }

        .prompt-template {
            position: relative;
            z-index: 1;
            padding: var(--spacing-xl);
            border: var(--border-width-1) dashed rgba(125, 230, 255, 0.45);
            border-radius: var(--radius-lg);
            background: var(--color-alpha-white-10);
            color: var(--color-white);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
            font-size: var(--font-size-sm);
            line-height: var(--line-height-loose);
        }

        .prompt-template strong {
            color: var(--color-white);
        }

        .token-tag {
            display: inline;
            padding: 0.1em 0.35em;
            border-radius: var(--radius-sm);
            background: rgba(0, 194, 255, 0.16);
            color: var(--color-cyan-100);
            font-weight: var(--font-weight-bold);
        }
















        @media (max-width: 900px) {
            .content-wrapper {
                padding: 0 var(--spacing-4);
            }

            .lesson-card,
            .interactive-eval-component,
            .slider-section,
            .checkpoint-container,
            .completion-card,
            .references-section {
                padding: var(--spacing-xl);
            }
        }

        @media (max-width: 768px) {
            .lesson-title {
                font-size: var(--font-size-3xl);
            }

            .top-nav {
                padding: 0 var(--spacing-4);
            }

            .module-title-nav {
                max-width: 58vw;
                font-size: var(--font-size-sm);
            }

            .slider-header,
            .footer-nav {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
            }

            .slider-controls,
            .eval-tabs {
                justify-content: center;
            }

            .workflow-step,
            .alert-box {
                flex-direction: column;
            }
        }

        @media (max-width: 520px) {
            :root {
                --module-sidebar-width: 86vw;
            }

            .module-title-nav {
                display: none;
            }

            .lesson-card,
            .interactive-eval-component,
            .slider-section,
            .checkpoint-container,
            .completion-card,
            .references-section,
            .comp-card,
            .eval-panel {
                padding: var(--spacing-md);
                border-radius: var(--radius-lg);
            }
        }
    </style>
</head>

<body data-page-id="leccion3_1" data-module-id="modulo3" data-page-type="leccion" data-title="Diseño de evaluación automatizada">

    <a href="#" class="btn-scroll-top" id="scrollTopBtn" aria-label="Subir al inicio de la página">↑</a>

    <div id="zoomModal" class="modal-zoom" role="dialog" aria-modal="true" aria-labelledby="zoom-title" aria-hidden="true">
        <div class="modal-content">
            <h2 id="zoom-title" class="sr-only">Imagen ampliada del recurso</h2>
            <button class="modal-close-btn" type="button" onclick="closeZoom()" aria-label="Cerrar imagen ampliada">×</button>
            <img id="zoomedImg" alt="Imagen ampliada del recurso">
        </div>
    </div>

    <script>
        function resolveAssetPath(img) {
            const fileName = img.dataset.asset;
            if (!fileName) return;
            const candidates = [`assets/${fileName}`, `./assets/${fileName}`, `/assets/${fileName}`];
            let index = 0;
            img.onerror = () => {
                if (index < candidates.length) {
                    img.src = candidates[index];
                    index += 1;
                } else {
                    img.onerror = null;
                    console.warn(`No se pudo cargar la imagen: ${fileName}`);
                }
            };
            img.src = candidates[index];
            index += 1;
        }
        document.querySelectorAll('img[data-asset]').forEach(resolveAssetPath);

        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        const menuButton = document.querySelector('.menu-btn');
        const zoomModal = document.getElementById('zoomModal');
        const zoomedImg = document.getElementById('zoomedImg');
        const scrollTopBtn = document.getElementById('scrollTopBtn');
        let lastFocusedElement = null;

        function openSidebar() {
            if (!sidebar || !overlay || !menuButton) return;
            sidebar.classList.add('active');
            overlay.classList.add('active');
            sidebar.setAttribute('aria-hidden', 'false');
            menuButton.setAttribute('aria-expanded', 'true');
            menuButton.setAttribute('aria-label', 'Cerrar menú de navegación');
        }

        function closeSidebar() {
            if (!sidebar || !overlay || !menuButton) return;
            sidebar.classList.remove('active');
            overlay.classList.remove('active');
            sidebar.setAttribute('aria-hidden', 'true');
            menuButton.setAttribute('aria-expanded', 'false');
            menuButton.setAttribute('aria-label', 'Abrir menú de navegación');
        }

        function toggleSidebar() {
            if (!sidebar) return;
            sidebar.classList.contains('active') ? closeSidebar() : openSidebar();
        }

        function openZoom(src) {
            if (!zoomModal || !zoomedImg) return;
            lastFocusedElement = document.activeElement;
            zoomedImg.src = src;
            zoomModal.classList.add('is-open');
            zoomModal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            const closeButton = zoomModal.querySelector('.modal-close-btn');
            if (closeButton) closeButton.focus();
        }

        function closeZoom() {
            if (!zoomModal || !zoomedImg) return;
            zoomModal.classList.remove('is-open');
            zoomModal.setAttribute('aria-hidden', 'true');
            zoomedImg.removeAttribute('src');
            document.body.style.overflow = '';
            if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
                lastFocusedElement.focus();
            }
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                if (zoomModal && zoomModal.classList.contains('is-open')) closeZoom();
                if (sidebar && sidebar.classList.contains('active')) {
                    closeSidebar();
                    menuButton?.focus();
                }
            }
        });

        zoomModal?.addEventListener('click', (event) => {
            if (event.target === zoomModal) closeZoom();
        });

        window.addEventListener('scroll', () => {
            if (!scrollTopBtn) return;
            scrollTopBtn.classList.toggle('visible', window.pageYOffset > 300);
        });

        scrollTopBtn?.addEventListener('click', (event) => {
            event.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        function showEvalTab(event, tabId) {
            document.querySelectorAll('.eval-panel').forEach((panel) => panel.classList.remove('active'));
            document.querySelectorAll('.eval-nav-btn').forEach((btn) => {
                btn.classList.remove('active');
                btn.setAttribute('aria-selected', 'false');
            });
            const selectedPanel = document.getElementById(tabId);
            if (selectedPanel) selectedPanel.classList.add('active');
            event.currentTarget.classList.add('active');
            event.currentTarget.setAttribute('aria-selected', 'true');
        }

        function updateEvalReactivo(level) {
            const display = document.getElementById('reactivoDisplay');
            if (!display) return;
            const reactivos = {
                recordar: {
                    title: 'Nivel Recordar',
                    prompt: '¿Cuál de las siguientes opciones identifica una fase del ciclo del agua?',
                    answer: 'Respuesta esperada: evaporación.'
                },
                comprender: {
                    title: 'Nivel Comprender',
                    prompt: 'Explica con tus propias palabras por qué la evaporación ocurre cuando el agua recibe calor.',
                    answer: 'Respuesta esperada: el estudiante relaciona calor, cambio de estado y vapor de agua.'
                },
                aplicar: {
                    title: 'Nivel Aplicar',
                    prompt: 'Observa un día lluvioso en tu comunidad y describe qué partes del ciclo del agua puedes identificar.',
                    answer: 'Respuesta esperada: identifica precipitación, acumulación y posible evaporación posterior.'
                },
                analizar: {
                    title: 'Nivel Analizar',
                    prompt: 'Compara cómo una sequía prolongada y una lluvia intensa afectan distintas fases del ciclo del agua en Puerto Rico.',
                    answer: 'Respuesta esperada: distingue efectos sobre precipitación, acumulación, escorrentía y disponibilidad de agua.'
                }
            };
            const item = reactivos[level];
            if (!item) return;
            display.innerHTML = `
                <h4>${item.title}</h4>
                <p><strong>Reactivo:</strong> ${item.prompt}</p>
                <p><strong>Validación docente:</strong> ${item.answer}</p>
            `;
        }

        document.addEventListener('DOMContentLoaded', () => {

        });
    </script>
    <script type="module" src="scripts/progress-tracker.js"></script>

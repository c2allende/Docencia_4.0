<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Lección 2.2 de Docencia 4.0: Del estándar a la planificación con IA. Uso de LLM para transformar estándares del DEPR en planes de clase y unidad viables.">
    <meta name="keywords"
        content="Docencia 4.0, Lección 2.2, planificación didáctica, LLM, DEPR, estándares, expectativas, LessonPlanner, alineación constructiva">
    <title>Lección 2.2 | Docencia 4.0</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="styles/main.css">
    <script type="module" src="scripts/auth-guard.js"></script>
    <script type="module" src="scripts/module-access-guard.js"></script>

    <style>
        :root {
            --nav-height: 80px;
            --module-sidebar-width: 320px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding-top: var(--nav-height);
            overflow-x: hidden;
            background: var(--color-background-page);
            color: var(--color-text-primary);
            font-family: var(--font-family-body);
            line-height: var(--line-height-loose);
        }

        p {
            margin: 0 0 var(--spacing-sm);
            color: var(--color-text-secondary);
        }

        strong {
            color: var(--color-text-primary);
            font-weight: var(--font-weight-bold);
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        /* NAVBAR SUPERIOR */
        .top-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            height: var(--nav-height);
            min-height: var(--nav-height);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 var(--spacing-md);
            background: var(--color-alpha-white-90);
            backdrop-filter: blur(var(--blur-lg));
            -webkit-backdrop-filter: blur(var(--blur-lg));
            border-bottom: var(--border-width-1) solid var(--color-border-default);
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            min-width: 0;
        }

        .logo-container img {
            height: 56px;
            width: auto;
            display: block;
            object-fit: contain;
            flex-shrink: 0;
        }

        .module-title-nav {
            max-width: 65vw;
            overflow: hidden;
            padding-left: var(--spacing-sm);
            margin-left: var(--spacing-xs);
            border-left: var(--border-width-2) solid var(--color-border-default);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-base);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .menu-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--spacing-2);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-md);
            background: var(--color-background-surface-medium);
            color: var(--color-brand-primary);
            cursor: pointer;
            transition: background-color var(--motion-duration-default) var(--motion-easing-standard),
                color var(--motion-duration-default) var(--motion-easing-standard),
                transform var(--motion-duration-default) var(--motion-easing-standard);
        }

        .menu-btn:hover {
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            transform: translateY(-1px);
        }

        .menu-btn:focus-visible,
        .menu-links a:focus-visible,
        .btn-footer:focus-visible,
        .control-btn:focus-visible,
        .app-nav-btn:focus-visible,
        .option-card:focus-visible,
        .btn-scroll-top:focus-visible,
        .genially-checkpoint__toggle:focus-visible,
        .genially-checkpoint__fallback:focus-visible,
        .genially-checkpoint iframe:focus-visible,
        .app-input-group input:focus-visible,
        .app-input-group textarea:focus-visible {
            outline: var(--border-width-2) solid var(--color-border-focus);
            outline-offset: var(--spacing-1);
        }

        /* MENÚ LATERAL */
        .module-sidebar {
            position: fixed;
            top: 0;
            left: calc(-1 * var(--module-sidebar-width) - 20px);
            z-index: 2000;
            width: var(--module-sidebar-width);
            height: 100vh;
            padding: var(--spacing-lg) var(--spacing-md);
            overflow-y: auto;
            background: var(--color-background-surface-dark);
            color: var(--color-text-inverse);
            transition: left var(--motion-duration-emphasis) var(--motion-easing-standard),
                box-shadow var(--motion-duration-default) var(--motion-easing-standard);
        }

        .module-sidebar.active {
            left: 0;
            box-shadow: 20px 0 50px var(--color-alpha-black-15);
        }

        .module-sidebar-overlay {
            position: fixed;
            inset: 0;
            z-index: 1999;
            display: none;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(var(--blur-sm));
            -webkit-backdrop-filter: blur(var(--blur-sm));
        }

        .module-sidebar-overlay.active {
            display: block;
        }

        .side-menu-title {
            margin: 0 0 var(--spacing-md);
            color: var(--color-text-inverse);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
        }

        .menu-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .menu-links li {
            margin-bottom: var(--spacing-xs);
        }

        .menu-section-label {
            display: block;
            padding: var(--spacing-5) var(--spacing-4) var(--spacing-2);
            color: var(--color-cyan-100);
            font-family: var(--font-family-body);
            font-size: var(--font-size-2xs);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
            letter-spacing: var(--letter-spacing-wider);
            text-transform: uppercase;
            opacity: 0.9;
        }

        .menu-links a {
            display: flex;
            align-items: center;
            gap: var(--spacing-3);
            padding: var(--spacing-3) var(--spacing-4);
            border-radius: var(--radius-md);
            color: var(--color-alpha-white-70);
            font-family: var(--font-family-body);
            font-size: var(--font-size-base);
            font-weight: var(--font-weight-semibold);
            line-height: var(--line-height-normal);
            text-decoration: none;
            transition: background-color var(--motion-duration-default) var(--motion-easing-standard),
                color var(--motion-duration-default) var(--motion-easing-standard);
        }

        .menu-links a:hover {
            background: var(--color-alpha-white-15);
            color: var(--color-cyan-100);
        }

        .menu-links a.active {
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            font-weight: var(--font-weight-bold);
        }

        /* CONTENIDO PRINCIPAL */
        .content-wrapper {
            max-width: 1100px;
            margin: var(--spacing-xl) auto var(--spacing-16);
            padding: 0 var(--spacing-md);
        }

        .lesson-card {
            position: relative;
            overflow: hidden;
            padding: var(--spacing-16);
            margin-bottom: var(--spacing-lg);
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-ambient);
        }

        .lesson-kicker {
            display: inline-block;
            margin-bottom: var(--spacing-sm);
            color: var(--color-brand-secondary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
        }

        .lesson-title {
            margin: 0 0 var(--spacing-lg);
            color: var(--color-text-display);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-4xl);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
            letter-spacing: var(--letter-spacing-tight);
        }

        .section-title {
            margin: 0 0 var(--spacing-md);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-2xl);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-snug);
        }

        .text-section,
        .lesson-section {
            margin-bottom: var(--spacing-12);
            scroll-margin-top: calc(var(--nav-height) + var(--spacing-xl));
        }

        .lesson-summary-card,
        .lesson-core-card,
        .lesson-callout,
        .lesson-evidence-card,
        .role-transfer-card,
        .remember-card,
        .lesson-section-card {
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
        }

        .lesson-summary-card {
            padding: var(--spacing-xl);
            margin-bottom: var(--spacing-lg);
            background: var(--color-background-surface-low);
            border-left: var(--border-width-6) solid var(--color-brand-primary);
        }

        .lesson-core-card {
            padding: var(--spacing-xl);
            margin-bottom: var(--spacing-12);
            background: var(--color-background-surface);
            border-left: var(--border-width-6) solid var(--color-brand-secondary);
        }

        .lesson-callout {
            padding: var(--spacing-lg);
            margin: var(--spacing-lg) 0;
            background: var(--color-background-surface-low);
            border-left: var(--border-width-6) solid var(--color-brand-secondary);
        }

        .lesson-evidence-card {
            padding: var(--spacing-lg);
            margin: var(--spacing-lg) 0;
            background: var(--color-background-surface-low);
            border-left: var(--border-width-6) solid var(--color-brand-primary);
        }

        .content-list {
            margin: var(--spacing-md) 0 var(--spacing-xl);
            padding-left: var(--spacing-6);
        }

        .content-list li {
            margin-bottom: var(--spacing-3);
            color: var(--color-text-secondary);
        }

        .content-list li::marker {
            color: var(--color-brand-primary);
            font-weight: var(--font-weight-extrabold);
        }

        .audio-player-container {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-2);
            padding: var(--spacing-lg);
            margin-bottom: var(--spacing-10);
            background: var(--color-background-surface-low);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-lg);
        }

        .audio-label {
            display: block;
            color: var(--color-brand-primary);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
        }

        .audio-player {
            width: 100%;
        }

        .visual-flow {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: var(--spacing-md);
            margin: var(--spacing-xl) 0;
        }

        .visual-flow__item {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 110px;
            padding: var(--spacing-lg);
            text-align: center;
            color: var(--color-text-display);
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-extrabold);
            background: var(--color-background-surface-low);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
        }

        .visual-flow__item span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            margin-right: var(--spacing-2);
            border-radius: var(--radius-pill);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            font-size: var(--font-size-sm);
        }

        .lesson-table-wrap {
            width: 100%;
            overflow-x: auto;
            margin: var(--spacing-xl) 0;
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            background: var(--color-background-surface);
            box-shadow: var(--shadow-flat);
        }

        .lesson-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 720px;
        }

        .lesson-table th,
        .lesson-table td {
            padding: var(--spacing-md);
            border-bottom: var(--border-width-1) solid var(--color-border-default);
            vertical-align: top;
            text-align: left;
        }

        .lesson-table th {
            color: var(--color-text-display);
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-extrabold);
            background: var(--color-background-surface-low);
        }

        .lesson-table tr:last-child td {
            border-bottom: 0;
        }

        .prompt-examples {
            display: grid;
            gap: var(--spacing-md);
            margin: var(--spacing-lg) 0;
        }

        .prompt-example-card {
            padding: var(--spacing-lg);
            background: var(--color-background-card-inverse);
            color: var(--color-alpha-white-90);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-ambient);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
            line-height: var(--line-height-loose);
        }

        .prompt-example-card strong {
            color: var(--color-cyan-100);
        }

        /* PRODUCTO INTERACTIVO */
        .interactive-app-wrapper {
            margin: var(--spacing-16) 0;
            padding: var(--spacing-xl);
            background: var(--color-background-surface-low);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
        }

        .app-container {
            max-width: 900px;
            margin: 0 auto;
            overflow: hidden;
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-ambient);
        }

        .app-header {
            padding: var(--spacing-xl);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            text-align: center;
        }

        .app-header h2 {
            margin: 0;
            color: var(--color-brand-primary-on);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-2xl);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-tight);
        }

        .ai-tag {
            display: inline-block;
            padding: var(--spacing-1) var(--spacing-3);
            margin-bottom: var(--spacing-sm);
            border-radius: var(--radius-pill);
            background: var(--color-alpha-white-20, rgba(255, 255, 255, 0.2));
            color: var(--color-brand-primary-on);
            font-size: var(--font-size-2xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
        }

        .stepper {
            display: flex;
            gap: var(--spacing-sm);
            padding: var(--spacing-md);
            overflow-x: auto;
            background: var(--color-background-surface-low);
            border-bottom: var(--border-width-1) solid var(--color-border-default);
        }

        .step {
            min-width: 80px;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: var(--spacing-1);
            color: var(--color-text-muted);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-bold);
            text-align: center;
        }

        .step-dot {
            width: 12px;
            height: 12px;
            border-radius: var(--radius-pill);
            background: var(--color-border-default);
            transition: transform var(--motion-duration-default) var(--motion-easing-standard),
                background-color var(--motion-duration-default) var(--motion-easing-standard);
        }

        .step.active {
            color: var(--color-brand-primary);
        }

        .step.active .step-dot {
            background: var(--color-brand-primary);
            transform: scale(1.2);
        }

        .app-main-content {
            min-height: 430px;
            padding: var(--spacing-xl);
            text-align: left;
        }

        .app-main-content h2 {
            margin: 0 0 var(--spacing-lg);
            color: var(--color-brand-primary);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-extrabold);
        }

        .app-input-group {
            margin-bottom: var(--spacing-lg);
        }

        .app-input-group label {
            display: block;
            margin-bottom: var(--spacing-2);
            color: var(--color-text-primary);
            font-weight: var(--font-weight-bold);
        }

        .app-input-group input,
        .app-input-group textarea {
            width: 100%;
            padding: var(--spacing-3);
            border: var(--border-width-2) solid var(--color-border-default);
            border-radius: var(--radius-md);
            background: var(--color-background-surface);
            color: var(--color-text-primary);
            font: inherit;
            outline: none;
            transition: border-color var(--motion-duration-default) var(--motion-easing-standard),
                box-shadow var(--motion-duration-default) var(--motion-easing-standard);
        }

        .app-input-group input:focus,
        .app-input-group textarea:focus {
            border-color: var(--color-brand-primary);
            box-shadow: var(--shadow-focus-primary);
        }

        .options-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--spacing-md);
            margin-top: var(--spacing-md);
        }

        .option-card {
            width: 100%;
            min-height: 110px;
            padding: var(--spacing-md);
            border: var(--border-width-2) solid var(--color-border-default);
            border-radius: var(--radius-lg);
            background: var(--color-background-surface);
            color: var(--color-text-primary);
            font: inherit;
            text-align: left;
            cursor: pointer;
            transition: border-color var(--motion-duration-default) var(--motion-easing-standard),
                background-color var(--motion-duration-default) var(--motion-easing-standard),
                transform var(--motion-duration-default) var(--motion-easing-standard),
                box-shadow var(--motion-duration-default) var(--motion-easing-standard);
        }

        .option-card:hover,
        .option-card.selected {
            transform: translateY(-2px);
            border-color: var(--color-brand-primary);
            background: var(--color-background-surface-low);
            box-shadow: var(--shadow-flat);
        }

        .option-card strong {
            display: block;
            margin-bottom: var(--spacing-1);
            color: var(--color-brand-primary);
        }

        .judgment-alert {
            display: flex;
            gap: var(--spacing-3);
            align-items: flex-start;
            padding: var(--spacing-md);
            margin-top: var(--spacing-lg);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-lg);
            background: var(--color-background-surface-low);
            color: var(--color-text-primary);
        }

        .judgment-alert p {
            margin: 0;
            font-size: var(--font-size-sm);
            line-height: var(--line-height-relaxed);
        }

        .app-footer {
            display: flex;
            justify-content: space-between;
            gap: var(--spacing-md);
            padding: var(--spacing-md) var(--spacing-xl);
            background: var(--color-background-surface-low);
            border-top: var(--border-width-1) solid var(--color-border-default);
        }

        .summary-box {
            padding: var(--spacing-lg);
            border-radius: var(--radius-lg);
            background: var(--color-background-surface-low);
            color: var(--color-text-secondary);
            font-size: var(--font-size-sm);
            line-height: var(--line-height-relaxed);
        }

        .summary-box hr {
            margin: var(--spacing-md) 0;
            border: 0;
            border-top: var(--border-width-1) solid var(--color-border-default);
        }

        .app-nav-btn {
            margin: 0;
            padding: var(--spacing-3) var(--spacing-lg);
            border: 0;
            cursor: pointer;
        }

        .app-nav-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Lectura progresiva */
        .lesson-progressive-list {
            display: grid;
            gap: var(--spacing-md);
            margin: var(--spacing-xl) 0;
        }

        .lesson-progressive-card {
            overflow: hidden;
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            background: var(--color-background-surface-low);
            box-shadow: var(--shadow-flat);
        }

        .lesson-progressive-card summary {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: var(--spacing-md);
            padding: var(--spacing-lg);
            cursor: pointer;
            list-style: none;
        }

        .lesson-progressive-card summary::-webkit-details-marker {
            display: none;
        }

        .lesson-progressive-card__icon {
            width: 46px;
            height: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-lg);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-extrabold);
            box-shadow: var(--shadow-focus-primary);
        }

        .lesson-progressive-card__title {
            display: block;
            color: var(--color-text-display);
            font-family: var(--font-family-heading);
            font-size: var(--font-size-lg);
            font-weight: var(--font-weight-extrabold);
            line-height: var(--line-height-snug);
        }

        .lesson-progressive-card__hint {
            display: block;
            color: var(--color-text-muted);
            font-size: var(--font-size-sm);
            line-height: var(--line-height-relaxed);
        }

        .lesson-progressive-card__cue {
            color: var(--color-brand-primary);
            font-size: var(--font-size-sm);
            font-weight: var(--font-weight-bold);
            white-space: nowrap;
        }

        .lesson-progressive-card__cue .summary-less,
        .lesson-progressive-card[open] .lesson-progressive-card__cue .summary-more {
            display: none;
        }

        .lesson-progressive-card[open] .lesson-progressive-card__cue .summary-less {
            display: inline;
        }

        .lesson-progressive-card__body {
            padding: 0 var(--spacing-lg) var(--spacing-lg) calc(var(--spacing-lg) + 62px);
            color: var(--color-text-secondary);
        }

        .role-transfer-card {
            padding: var(--spacing-xl);
            margin: var(--spacing-12) 0;
            background: var(--color-background-surface-low);
        }

        .role-progressive-shell {
            overflow: hidden;
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            background: var(--color-background-surface-low);
            box-shadow: var(--shadow-flat);
        }

        .role-progressive-shell__summary {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            gap: var(--spacing-md);
            padding: var(--spacing-xl);
            cursor: pointer;
            list-style: none;
        }

        .role-progressive-shell__summary::-webkit-details-marker {
            display: none;
        }

        .role-progressive-shell__icon {
            width: 52px;
            height: 52px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-lg);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            font-size: var(--font-size-xl);
            box-shadow: var(--shadow-focus-primary);
        }

        .role-progressive-shell__meta {
            display: grid;
            gap: var(--spacing-2);
        }

        .role-progressive-shell__title {
            display: block;
            margin: 0;
        }

        .role-progressive-shell__description {
            display: block;
            color: var(--color-text-secondary);
            font-size: var(--font-size-base);
            line-height: var(--line-height-relaxed);
        }

        .role-progressive-shell__cue {
            color: var(--color-brand-primary);
            font-size: var(--font-size-sm);
            font-weight: var(--font-weight-bold);
            white-space: nowrap;
        }

        .role-progressive-shell__cue .summary-less,
        .role-progressive-shell[open] .role-progressive-shell__cue .summary-more {
            display: none;
        }

        .role-progressive-shell[open] .role-progressive-shell__cue .summary-less {
            display: inline;
        }

        .role-progressive-shell__body {
            padding: 0 var(--spacing-xl) var(--spacing-xl);
        }

        .role-progressive-shell__body .lesson-progressive-list {
            margin-top: 0;
            margin-bottom: 0;
        }

        .remember-card {
            padding: var(--spacing-xl);
            margin: var(--spacing-12) 0;
            background: var(--color-background-surface);
            border-left: var(--border-width-6) solid var(--color-brand-primary);
        }

        .remember-list {
            list-style: none;
            padding: 0;
            margin: var(--spacing-lg) 0 0;
        }

        .remember-list li {
            position: relative;
            padding: var(--spacing-md) var(--spacing-md) var(--spacing-md) var(--spacing-12);
            margin-bottom: var(--spacing-sm);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-lg);
            background: var(--color-background-surface-low);
            color: var(--color-text-secondary);
        }

        .remember-list li::before {
            content: "✅";
            position: absolute;
            top: var(--spacing-md);
            left: var(--spacing-md);
            color: var(--color-brand-primary);
            font-weight: var(--font-weight-extrabold);
        }

        .completion-card {
            position: relative;
            margin-top: var(--spacing-16);
            padding: var(--spacing-xl);
            background: var(--color-background-surface);
            border: var(--border-width-1) solid var(--color-border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-flat);
        }

        .completion-badge {
            position: absolute;
            top: calc(-1 * var(--spacing-5));
            right: var(--spacing-xl);
            padding: var(--spacing-2) var(--spacing-5);
            border-radius: var(--radius-pill);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-extrabold);
            letter-spacing: var(--letter-spacing-wide);
            text-transform: uppercase;
        }

        .section-separator {
            border: 0;
            border-top: var(--border-width-1) solid var(--color-border-default);
            margin: var(--spacing-16) 0 var(--spacing-xl);
        }

        .footer-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: var(--spacing-md);
            margin-top: var(--spacing-16);
            padding-top: var(--spacing-xl);
            border-top: var(--border-width-1) solid var(--color-border-default);
        }

        .btn-footer {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--spacing-2);
            padding: var(--spacing-4) var(--spacing-xl);
            border-radius: var(--radius-pill);
            font-family: var(--font-family-heading);
            font-weight: var(--font-weight-bold);
            text-decoration: none;
            transition: transform var(--motion-duration-default) var(--motion-easing-standard),
                box-shadow var(--motion-duration-default) var(--motion-easing-standard),
                background-color var(--motion-duration-default) var(--motion-easing-standard);
        }

        .btn-back,
        .btn-prev {
            background: var(--color-background-surface-low);
            color: var(--color-text-primary);
        }

        .btn-back:hover,
        .btn-prev:hover {
            transform: translateX(-5px);
        }

        .btn-next {
            background: var(--color-background-button-primary-default, var(--color-brand-secondary));
            color: var(--color-text-button-primary-default, var(--color-white));
            box-shadow: var(--shadow-focus-secondary);
        }

        .btn-next:hover {
            transform: translateX(5px);
            box-shadow: var(--shadow-floating);
        }

        .btn-scroll-top {
            position: fixed;
            right: var(--spacing-lg);
            bottom: var(--spacing-lg);
            z-index: 100;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-pill);
            background: var(--color-brand-primary);
            color: var(--color-brand-primary-on);
            text-decoration: none;
            box-shadow: var(--shadow-floating);
            opacity: 0;
            visibility: hidden;
            transition: opacity var(--motion-duration-default) var(--motion-easing-standard),
                visibility var(--motion-duration-default) var(--motion-easing-standard),
                transform var(--motion-duration-default) var(--motion-easing-standard);
        }

        .btn-scroll-top.visible {
            opacity: 1;
            visibility: visible;
        }

        .btn-scroll-top:hover {
            transform: translateY(-3px);
        }

        @media (max-width: 900px) {
            .content-wrapper {
                padding: 0 var(--spacing-4);
            }

            .lesson-card,
            .interactive-app-wrapper {
                padding: var(--spacing-xl);
            }

            .visual-flow {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .options-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .lesson-title {
                font-size: var(--font-size-3xl);
            }

            .top-nav {
                padding: 0 var(--spacing-4);
            }

            .module-title-nav {
                max-width: 58vw;
                font-size: var(--font-size-sm);
            }

            .footer-nav {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
            }

            .app-footer {
                flex-direction: column;
            }
        }

        @media (max-width: 520px) {
            :root {
                --module-sidebar-width: 86vw;
            }

            .module-title-nav {
                display: none;
            }

            .lesson-card,
            .interactive-app-wrapper,
            .completion-card,
            .role-transfer-card,
            .remember-card,
            .lesson-summary-card,
            .lesson-core-card {
                padding: var(--spacing-md);
                border-radius: var(--radius-lg);
            }

            .visual-flow {
                grid-template-columns: 1fr;
            }

            .lesson-progressive-card summary {
                grid-template-columns: minmax(0, 1fr);
            }

            .role-progressive-shell__summary {
                grid-template-columns: minmax(0, 1fr);
            }

            .role-progressive-shell__body {
                padding: 0 var(--spacing-md) var(--spacing-md);
            }

            .lesson-progressive-card__body {
                padding: 0 var(--spacing-lg) var(--spacing-lg);
            }
        }
    </style>
</head>

<body data-page-id="leccion2_2" data-module-id="modulo2" data-page-type="leccion" data-title="Lección 2.2">
    <nav class="top-nav" aria-label="Navegación superior de la lección">

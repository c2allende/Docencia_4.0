{
  "hosting": {
    "public": "docencia-4.0",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.agents/**",
      "**/backups/**",
      "**/design/**",
      "**/raw_assets/**",
      "**/*.zip",
      "**/*.psd",
      "_archivo_no_oficiales/**",
      "QA_Auditoria_Forense_Diseno/**",
      "**/*.bak",
      "**/*.bak.*",
      "*_prototype.html",
      "*prototype*.html",
      "**/docs/**",
      "**/scratch/**"
    ],
    "headers": [
      {
        "source": "/scripts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}

{
  "hosting": {
    "public": "docencia-4.0",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.agents/**",
      "**/backups/**",
      "**/design/**",
      "**/raw_assets/**",
      "**/*.zip",
      "**/*.psd"
    ],
    "headers": [
      {
        "source": "/scripts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE SEGURIDAD ---
    
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.status == "active";
    }

    // --- VALIDACIONES DE DATOS ---

    function validAnnouncementFields() {
      return request.resource.data.keys().hasOnly([
        "title", "message", "scope", "moduleId", "priority", 
        "status", "isActive", "publishAt", "expiresAt", 
        "createdBy", "createdAt", "updatedAt"
      ]);
    }

    function validAnnouncementValues() {
      return request.resource.data.priority in ["normal", "importante", "urgente"]
        && request.resource.data.status in ["draft", "published", "archived"]
        && request.resource.data.scope in ["global", "module"];
    }

    function isVisibleAnnouncement() {
      return resource.data.status == "published"
        && resource.data.isActive == true
        && resource.data.publishAt <= request.time
        && (
          !("expiresAt" in resource.data)
          || resource.data.expiresAt == null
          || resource.data.expiresAt > request.time
        );
    }

    // --- REGLAS DE COLECCIONES ---

    // 1. Usuarios
    match /usuarios/{userId} {
      // El usuario puede leer su propio perfil. El admin puede leer todos.
      allow read: if isOwner(userId) || isAdmin();

      // Registro inicial: Obligatorio rol participant y status active.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "uid", "email", "displayName", "roleContext", "role", 
          "status", "emailVerified", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "participant"
        && request.resource.data.status == "active";

      // Actualización protegida
      allow update: if signedIn() && (
        (isOwner(userId) && (
          // El usuario NO puede modificar campos críticos ni añadir campos arbitrarios
          request.resource.data.keys().hasOnly([
            "uid", "email", "displayName", "roleContext", "role", 
            "status", "emailVerified", "createdAt", "updatedAt"
          ])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "status", "uid", "email", "createdAt"])
        )) || (isAdmin() && (
          // El admin puede modificar role y status, pero no uid/email/createdAt del usuario
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["uid", "email", "createdAt"])
        ))
      );

      // 1.1. Lectura de Anuncios (Subcolección de usuario)
      match /anuncioLecturas/{announcementId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(["announcementId", "readAt"])
          && request.resource.data.announcementId == announcementId;
        allow delete: if false;
      }

      // 1.2. Progreso de Páginas
      match /progresoPaginas/{pageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin())
          && request.resource.data.keys().hasOnly([
            "uid", "pageId", "moduleId", "pageType", "title", "url", 
            "status", "visitCount", "firstOpenedAt", "lastOpenedAt", 
            "updatedAt", "completedAt"
          ])
          && request.resource.data.status in ["started", "completed"]
          && request.resource.data.uid == userId
          && request.resource.data.pageId == pageId;
        allow delete: if false;
      }

      // 1.3. Progreso de Módulos
      match /progresoModulos/{moduleId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin())
          && request.resource.data.keys().hasOnly([
            "uid", "moduleId", "moduleTitle", "completedPages", "totalPages", 
            "percentComplete", "status", "updatedAt", "startedAt", "completedAt"
          ])
          && request.resource.data.status in ["not_started", "in_progress", "completed"]
          && request.resource.data.uid == userId
          && request.resource.data.moduleId == moduleId;
        allow delete: if false;
      }
    }

    // 2. Anuncios (Colección Global)
    match /anuncios/{announcementId} {
      // Participantes leen lo vigente (get individual).
      // Para listados (list), se permite si está publicado y activo para facilitar la consulta.
      allow get: if signedIn() && (isVisibleAnnouncement() || isAdmin());
      allow list: if signedIn() && (
        (resource.data.status == "published" && resource.data.isActive == true) || isAdmin()
      );

      // Solo admins gestionan anuncios
      allow create: if isAdmin()
        && validAnnouncementFields()
        && validAnnouncementValues()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        && validAnnouncementFields()
        && validAnnouncementValues();

      // Prohibido borrado físico
      allow delete: if false;
    }
    
    // 3. Auditoría Admin
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.action == "reset_module_progress"
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.moduleId in ["modulo1", "modulo2", "modulo3"];
      allow update, delete: if false;
    }
  }
}

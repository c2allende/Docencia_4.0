rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE SEGURIDAD ---
    
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid == "9l2MOKU8Y9ayX9yHmxtAcpGkzcJ2" ||
        request.auth.token.email == "carmelo.allende@gmail.com"
      );
    }

    // --- CONTROL DE MATRÍCULA ---
    function enrollmentIsOpen() {
      let config = get(/databases/$(database)/documents/configuracion/registro).data;
      return exists(/databases/$(database)/documents/configuracion/registro)
          && config.enrollmentEnabled == true
          && request.time >= config.get("enrollmentStartAt", request.time)
          && request.time <= config.get("enrollmentEndAt", request.time);
    }

    // --- VALIDACIONES DE DATOS ---

    function validAnnouncementFields() {
      return request.resource.data.keys().hasOnly([
        "title", "message", "scope", "moduleId", "priority", 
        "status", "isActive", "publishAt", "expiresAt", 
        "createdBy", "createdAt", "updatedAt"
      ]) && request.resource.data.keys().hasAll([
        "title", "message", "scope", "priority", "status", "isActive", "createdBy", "createdAt", "updatedAt"
      ]);
    }

    function validAnnouncementValues() {
      return request.resource.data.priority in ["normal", "importante", "urgente"]
        && request.resource.data.status in ["draft", "published", "archived"]
        && request.resource.data.scope in ["global", "module"];
    }

    // La validación de expiresAt se delega al cliente (announcement-service.js)
    // para evitar que la condición de existencia de campo bloquee las queries filtradas.
    function isVisibleAnnouncement() {
      return resource.data.status == "published"
        && resource.data.isActive == true
        && resource.data.publishAt <= request.time;
    }

    // --- REGLAS DE COLECCIONES ---

    // 1. Usuarios
    match /usuarios/{userId} {
      // Lectura individual: Solo el dueño o un administrador
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      
      // Listado: Solo administradores
      allow list: if isAdmin();

      // Creación: Solo el propio usuario y si la matrícula está abierta, o si es un administrador
      allow create: if (signedIn() && request.auth.uid == userId && enrollmentIsOpen()
          && request.resource.data.role == "participant"
          && request.resource.data.roleContext == "Participante"
          && request.resource.data.status == "active") || isAdmin();

      allow update: if signedIn() && (
        // CAMINO 1: Actualización de perfil propio (Campos básicos)
        (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName", "roleContext", "emailVerified", "updatedAt"
          ])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "role", "status", "uid", "email", "createdAt", "accessRevoked"
          ])
        ) ||
        // CAMINO 2: Actualización de progreso propio (Resumen denormalizado para Admin)
        (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "progress", "lastActivity", "updatedAt"
          ])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "role", "status", "uid", "email", "createdAt", "accessRevoked", 
            "displayName", "roleContext"
          ])
        ) ||
        // CAMINO 3: Actualización Administrativa
        (
          isAdmin() && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["uid", "email", "createdAt"])
          )
        )
      );

      allow delete: if isAdmin();

      // 1.1. Lectura de Anuncios
      match /anuncioLecturas/{announcementId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(["announcementId", "readAt"])
          && request.resource.data.announcementId == announcementId;
      }

      // 1.2. Progreso de Páginas
      match /progresoPaginas/{pageId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "uid", "pageId", "moduleId", "pageType", "title", "url", 
            "status", "visitCount", "firstOpenedAt", "lastOpenedAt", 
            "updatedAt", "completedAt"
          ])
          && request.resource.data.uid == userId
          && request.resource.data.pageId == pageId
          && request.resource.data.status in ["started", "completed"];

        allow update: if (isOwner(userId) && (
          request.resource.data.keys().hasOnly([
            "uid", "pageId", "moduleId", "pageType", "title", "url", 
            "status", "visitCount", "firstOpenedAt", "lastOpenedAt", 
            "updatedAt", "completedAt"
          ])
          && request.resource.data.status in ["started", "completed"]
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["uid", "pageId", "moduleId"])
        )) || (isAdmin() && (
          // CASO 1.8A: Reinicio controlado
          (request.resource.data.status == "started" && request.resource.data.completedAt == null &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "completedAt", "updatedAt"])) ||
          // CASO 1.8B-B: Archivado lógico
          (request.resource.data.archived == true && 
           request.resource.data.archivedBy == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             "archived", "archivedAt", "archivedBy", "archiveReason", "updatedAt"
           ]))
        ));
        
        allow delete: if isAdmin();
      }

      // 1.3. Progreso de Módulos
      match /progresoModulos/{moduleId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "uid", "moduleId", "moduleTitle", "completedPages", "totalPages", 
            "percentComplete", "status", "updatedAt", "startedAt", "completedAt"
          ])
          && request.resource.data.uid == userId
          && request.resource.data.moduleId == moduleId
          && request.resource.data.status in ["not_started", "in_progress", "completed"];

        allow update: if (isOwner(userId) && (
          request.resource.data.keys().hasOnly([
            "uid", "moduleId", "moduleTitle", "completedPages", "totalPages", 
            "percentComplete", "status", "updatedAt", "startedAt", "completedAt"
          ])
          && request.resource.data.status in ["not_started", "in_progress", "completed"]
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["uid", "moduleId"])
        )) || (isAdmin() && (
          // CASO 1.8A: Reinicio controlado
          (request.resource.data.completedPages == 0 && request.resource.data.percentComplete == 0 && 
           request.resource.data.status == "not_started" && request.resource.data.completedAt == null &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             "completedPages", "percentComplete", "status", "completedAt", "updatedAt"
           ])) ||
          // CASO 1.8B-B: Archivado lógico
          (request.resource.data.archived == true && 
           request.resource.data.archivedBy == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             "archived", "archivedAt", "archivedBy", "archiveReason", "updatedAt"
           ]))
        ));
        
        allow delete: if isAdmin();
      }

      // 1.4. Notificaciones
      match /notificaciones/{notificationId} {
        allow get, list: if isOwner(userId) || isAdmin();

        allow create: if (isAdmin()
          && request.resource.data.keys().hasAll([
            "type", "title", "message", "status", "priority", "sourceType", "createdAt"
          ])
          && request.resource.data.keys().hasOnly([
            "type", "title", "message", "status", "priority", "sourceType",
            "sourceId", "moduleId", "createdAt", "readAt", "actionUrl", "updatedAt"
          ])
          && request.resource.data.type in [
            "system_alert", "announcement", "progress", "forum", "moderation"
          ]
          && request.resource.data.status == "unread"
          && request.resource.data.priority in ["normal", "importante", "urgente"]
          && request.resource.data.sourceType in ["progress", "forum", "announcement", "system"]
        ) || (
          // FASE 2.0C: El usuario puede crear su propia notificación de progreso completado
          isOwner(userId)
          && notificationId == "progress_module_completed_" + request.resource.data.moduleId
          && request.resource.data.keys().hasAll([
            "type", "title", "message", "status", "priority", "sourceType", "sourceId", "moduleId", "createdAt", "actionUrl"
          ])
          && request.resource.data.keys().hasOnly([
            "type", "title", "message", "status", "priority", "sourceType", "sourceId", "moduleId", "createdAt", "readAt", "actionUrl", "updatedAt"
          ])
          && request.resource.data.type == "progress"
          && request.resource.data.sourceType == "progress"
          && request.resource.data.sourceId in ["modulo1", "modulo2", "modulo3"]
          && request.resource.data.moduleId == request.resource.data.sourceId
          && request.resource.data.status == "unread"
          && request.resource.data.priority == "normal"
          && request.resource.data.actionUrl == "dashboard.html"
          && get(/databases/$(database)/documents/usuarios/$(userId)/progresoModulos/$(request.resource.data.moduleId)).data.status == "completed"
          && get(/databases/$(database)/documents/usuarios/$(userId)/progresoModulos/$(request.resource.data.moduleId)).data.percentComplete == 100
        ) || (
          // FASE 2.0E-3: Notificación administrativa automática por módulo completado
          // El participante notifica a los administradores de la lista blanca
          request.auth != null
          && request.auth.uid == request.resource.data.participantUid
          && notificationId == "admin_module_completed_" + request.auth.uid + "_" + request.resource.data.moduleId
          && request.resource.data.keys().hasAll([
            "type", "title", "message", "status", "priority", "sourceType", 
            "sourceId", "moduleId", "participantUid", "createdAt", "actionUrl"
          ])
          && request.resource.data.keys().hasOnly([
            "type", "title", "message", "status", "priority", "sourceType", 
            "sourceId", "moduleId", "participantUid", "createdAt", "actionUrl"
          ])
          && request.resource.data.type == "system_alert"
          && request.resource.data.sourceType == "progress"
          && request.resource.data.priority == "importante"
          && request.resource.data.status == "unread"
          && request.resource.data.actionUrl == "admin_progreso.html"
          && request.resource.data.sourceId in ["modulo1", "modulo2", "modulo3"]
          && request.resource.data.moduleId == request.resource.data.sourceId
          && get(/databases/$(database)/documents/usuarios/$(userId)).data.role == "admin"
          && get(/databases/$(database)/documents/usuarios/$(userId)).data.status == "active"
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)/progresoModulos/$(request.resource.data.moduleId)).data.status == "completed"
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)/progresoModulos/$(request.resource.data.moduleId)).data.percentComplete == 100
        );

        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "readAt", "updatedAt"
          ])
          && request.resource.data.status in ["read", "archived"]
          && resource.data.status != "archived";

        allow delete: if isAdmin();
      }
    }

    // 2. Anuncios (Colección Global)
    match /anuncios/{announcementId} {
      allow get, list: if signedIn() && (isVisibleAnnouncement() || isAdmin());

      allow create: if isAdmin()
        && validAnnouncementFields()
        && validAnnouncementValues()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        && validAnnouncementFields()
        && validAnnouncementValues();

      allow delete: if isAdmin() && resource.data.status == "archived";
    }
    
    // 3. Auditoría Admin
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && (
        // FASE 2.0F-6: Gestión de Usuarios (Activación, Inactivación, Archivado)
        (request.resource.data.action in ["user_activated", "user_deactivated", "user_archived", "user_updated"] &&
         request.resource.data.performedBy == request.auth.uid &&
         request.resource.data.keys().hasAll([
           'action', 'targetUid', 'targetEmail', 'previousStatus', 'newStatus',
           'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]))
        ||
        // Reinicio de progreso de módulos (9 campos exactos)
        (request.resource.data.action == "reset_module_progress" &&
         request.resource.data.performedBy == request.auth.uid &&
         request.resource.data.keys().hasAll([
           'action', 'targetUid', 'targetEmail', 'moduleId', 'moduleTitle',
           'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]) &&
         request.resource.data.keys().hasOnly([
           'action', 'targetUid', 'targetEmail', 'moduleId', 'moduleTitle',
           'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]))
        ||
        // Moderación de foros: publicación (11 campos exactos)
        (request.resource.data.action == "moderate_forum_post" &&
         request.resource.data.performedBy == request.auth.uid &&
         request.resource.data.keys().hasAll([
           'action', 'foroId', 'postId', 'targetUid', 'targetAuthorName',
           'previousStatus', 'newStatus', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]) &&
         request.resource.data.keys().hasOnly([
           'action', 'foroId', 'postId', 'targetUid', 'targetAuthorName',
           'previousStatus', 'newStatus', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]))
        ||
        // Moderación de foros: respuesta (12 campos exactos, incluye replyId)
        (request.resource.data.action == "moderate_forum_reply" &&
         request.resource.data.performedBy == request.auth.uid &&
         request.resource.data.keys().hasAll([
           'action', 'foroId', 'postId', 'replyId', 'targetUid', 'targetAuthorName',
           'previousStatus', 'newStatus', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]) &&
         request.resource.data.keys().hasOnly([
           'action', 'foroId', 'postId', 'replyId', 'targetUid', 'targetAuthorName',
           'previousStatus', 'newStatus', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]))
        ||
        // Exportación de datos de foros (11 campos exactos)
        (request.resource.data.action == "export_forum_data" &&
         request.resource.data.performedBy == request.auth.uid &&
         request.resource.data.keys().hasAll([
           'action', 'exportType', 'foroId', 'statusFilter', 'typeFilter',
           'dateFrom', 'dateTo', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]) &&
         request.resource.data.keys().hasOnly([
           'action', 'exportType', 'foroId', 'statusFilter', 'typeFilter',
           'dateFrom', 'dateTo', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]))
        ||
        // Purga de registros archivados de foros (9 campos exactos)
        (request.resource.data.action == "purge_archived_forum_records" &&
         request.resource.data.performedBy == request.auth.uid &&
         request.resource.data.keys().hasAll([
           'action', 'foroId', 'archivedPostsDeleted', 'archivedRepliesDeleted',
           'skippedPosts', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]) &&
         request.resource.data.keys().hasOnly([
           'action', 'foroId', 'archivedPostsDeleted', 'archivedRepliesDeleted',
           'skippedPosts', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]))
        ||
        // Purga de anuncios archivados (7 campos exactos)
        (request.resource.data.action == "purge_archived_announcements" &&
         request.resource.data.performedBy == request.auth.uid &&
         request.resource.data.keys().hasAll([
           'action', 'announcementsDeleted', 'skippedAnnouncements',
           'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]) &&
         request.resource.data.keys().hasOnly([
           'action', 'announcementsDeleted', 'skippedAnnouncements',
           'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]))
        ||
        // Borrado individual de anuncio (6 campos exactos)
        (request.resource.data.action == "delete_single_announcement" &&
         request.resource.data.performedBy == request.auth.uid &&
         request.resource.data.keys().hasAll([
           'action', 'targetId', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]) &&
         request.resource.data.keys().hasOnly([
           'action', 'targetId', 'performedBy', 'performedByEmail', 'createdAt', 'note'
         ]))
      );
      allow update, delete: if false;
    }

    // 4. Foros Dinámicos
    match /foros/{foroId} {
      allow get, list: if (signedIn() && resource.data.isActive == true) || isAdmin();
      
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "title", "description", "moduleId", "isActive", "visibility", "createdAt", "updatedAt"
        ])
        && request.resource.data.isActive is bool
        && request.resource.data.visibility in ["authenticated", "private"];
        
      allow delete: if false;
      
      match /publicaciones/{postId} {
        allow read: if (signedIn() && resource.data.status == "active") || isAdmin();
        
        allow create: if isOwner(request.resource.data.uid)
          && request.resource.data.keys().hasAll([
            "foroId", "uid", "authorName", "authorContext", "content", "status", "createdAt", "updatedAt", "replyCount"
          ])
          && request.resource.data.keys().hasOnly([
            "foroId", "uid", "authorName", "authorContext", "content", "status", "createdAt", "updatedAt", "replyCount"
          ])
          && request.resource.data.foroId == foroId
          && request.resource.data.status == "active"
          && request.resource.data.content != ""
          && get(/databases/$(database)/documents/foros/$(foroId)).data.isActive == true;
          
        allow update: if (isOwner(resource.data.uid) && resource.data.status == "active" && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt'])
          && request.resource.data.content != ""
        )) || (isAdmin() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedAt', 'moderatedBy'])
          && request.resource.data.moderatedBy == request.auth.uid
          && request.resource.data.status in ["active", "hidden", "archived"]
        ));
        
        allow delete: if isAdmin() && resource.data.status == "archived";

        match /respuestas/{replyId} {
          allow read: if (signedIn() && resource.data.status == "active") || isAdmin();
          
          allow create: if isOwner(request.resource.data.uid)
            && request.resource.data.keys().hasAll([
              "foroId", "postId", "uid", "authorName", "authorContext", "content", "status", "createdAt", "updatedAt"
            ])
            && request.resource.data.keys().hasOnly([
              "foroId", "postId", "uid", "authorName", "authorContext", "content", "status", "createdAt", "updatedAt"
            ])
            && request.resource.data.foroId == foroId
            && request.resource.data.postId == postId
            && request.resource.data.status == "active"
            && request.resource.data.content != ""
            && get(/databases/$(database)/documents/foros/$(foroId)).data.isActive == true;
            
          allow update: if (isOwner(resource.data.uid) && resource.data.status == "active" && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt'])
            && request.resource.data.content != ""
          )) || (isAdmin() && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedAt', 'moderatedBy'])
            && request.resource.data.moderatedBy == request.auth.uid
            && request.resource.data.status in ["active", "hidden", "archived"]
          ));
          
          allow delete: if isAdmin() && resource.data.status == "archived";
        }
      }
    }

    // ─── CONFIGURACIÓN DE PLATAFORMA ──────────────────────────────────────────
    // configuracion/modulos — control de acceso por módulo
    // configuracion/registro — periodo de matrícula (lectura pública para registro.html)
    match /configuracion/{docId} {
      // registro es legible sin autenticación (para verificar matrícula en registro.html)
      allow get: if signedIn() || docId == "registro";
      allow list: if signedIn();

      // Solo admin puede crear o actualizar documentos autorizados
      allow create, update: if isAdmin() && (docId == "modulos" || docId == "registro");

      // Delete bloqueado permanentemente
      allow delete: if false;
    }

    // 5. Tableros Interactivos (Sessions)
    match /sessions/{sessionId} {
      allow get: if signedIn();
      
      match /responses/{responseId} {
        allow read: if signedIn();
        
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.text.size() <= 200
          && request.resource.data.keys().hasAll([
            "text", "uid", "displayName", "timestamp", "likes", "colorIndex", "pageId", "moduleId", "status"
          ])
          && request.resource.data.keys().hasOnly([
            "text", "uid", "displayName", "timestamp", "likes", "colorIndex", "pageId", "moduleId", "status"
          ]);

        allow update, delete: if isAdmin();
      }
    }


    // 7. Accesos Investigación (Dashboard)
    match /researchAccess/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin() && docId == "config";
    }

    // 6. Comunicaciones (Panel Administrativo)
    match /comunicaciones/{communicationId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

  }
}
